{
  "manifest": 1,
  "id": "weather",
  "package": "kiosko-plugin-weather",
  "name": {
    "en": "Weather",
    "es": "El tiempo",
    "zh-Hant": "天氣",
    "zh-Hans": "天气"
  },
  "version": "0.2.1",
  "description": {
    "en": "Weather from Open-Meteo, shared with every widget, and a forecast card.",
    "es": "El tiempo de Open-Meteo, compartido con todos los widgets, y una tarjeta de previsión.",
    "zh-Hant": "來自 Open-Meteo 的天氣，供所有小工具共用，另附一張預報卡片。",
    "zh-Hans": "来自 Open-Meteo 的天气，供所有小组件共享，另附一张预报卡片。"
  },
  "author": "Kiosko",
  "license": "MIT",
  "homepage": "https://github.com/kiosko-lcd/kiosko-plugin-weather#readme",
  "repository": "https://github.com/kiosko-lcd/kiosko-plugin-weather.git",
  "icon": "cloud-sun",
  "sdk": "^0.2.0",
  "platforms": [
    "linux",
    "darwin",
    "win32"
  ],
  "languages": [
    "en",
    "es",
    "zh-Hant",
    "zh-Hans"
  ],
  "categories": [
    "info"
  ],
  "tags": [
    "weather",
    "tiempo",
    "forecast",
    "moon"
  ],
  "permissions": {
    "network": [
      "api.open-meteo.com"
    ]
  },
  "riskyOptions": [],
  "requires": [],
  "optional": [],
  "widgets": [
    {
      "type": "weather/forecast",
      "name": {
        "en": "Weather forecast",
        "es": "Previsión del tiempo",
        "zh-Hant": "天氣預報",
        "zh-Hans": "天气预报"
      },
      "description": {
        "en": "Temperature and sky now, the next hours (temperature curve and rain) and days, and the moon when there is room.",
        "es": "Temperatura y cielo ahora, las próximas horas (curva de temperatura y lluvia) y días, y la luna si hay sitio.",
        "zh-Hant": "現在的溫度與天空狀況、未來幾小時（溫度曲線與降雨）和未來幾天，空間足夠時還有月相。",
        "zh-Hans": "当前温度和天空状况、未来几小时（温度曲线和降水）和未来几天，空间足够时还有月相。"
      },
      "icon": "cloud-sun",
      "category": "info",
      "tags": [
        "weather",
        "tiempo",
        "forecast",
        "moon"
      ],
      "size": {
        "min": {
          "w": 120,
          "h": 70
        },
        "preferred": {
          "w": 900,
          "h": 300
        }
      },
      "chrome": "card",
      "sources": [
        "weather/current"
      ],
      "options": {
        "default": {
          "hours": 12,
          "hourStep": 1,
          "days": 3,
          "showMoon": true,
          "showDetails": false
        },
        "x-ui": {},
        "type": "object",
        "properties": {
          "hours": {
            "title": "Next hours",
            "description": "How far ahead the hourly chart goes, as many hours as fit. 0 hides it.",
            "default": 12,
            "x-ui": {
              "label": {
                "en": "Next hours",
                "es": "Próximas horas",
                "zh-Hant": "未來幾小時",
                "zh-Hans": "未来几小时"
              },
              "help": {
                "en": "How far ahead the hourly chart goes, as many hours as fit. 0 hides it.",
                "es": "Hasta dónde llega la gráfica por horas, las que quepan. 0 la oculta.",
                "zh-Hant": "逐時圖表涵蓋的時間長度，能放幾小時就放幾小時。0 表示隱藏。",
                "zh-Hans": "逐小时图表覆盖的时间长度，能放几小时就放几小时。0 表示隐藏。"
              },
              "unit": "h"
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 48
          },
          "hourStep": {
            "title": "One column every",
            "description": "2 or 3 fit a whole day in a narrow tile.",
            "default": 1,
            "x-ui": {
              "label": {
                "en": "One column every",
                "es": "Una columna cada",
                "zh-Hant": "每欄間隔",
                "zh-Hans": "每列间隔"
              },
              "help": {
                "en": "2 or 3 fit a whole day in a narrow tile.",
                "es": "Con 2 o 3 cabe un día entero en una tesela estrecha.",
                "zh-Hant": "設為 2 或 3，窄方格也能放下一整天。",
                "zh-Hans": "设为 2 或 3，窄格子也能放下一整天。"
              },
              "unit": "h"
            },
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "days": {
            "title": "Next days",
            "description": "Today included, as many as fit. 0 hides them.",
            "default": 3,
            "x-ui": {
              "label": {
                "en": "Next days",
                "es": "Próximos días",
                "zh-Hant": "未來幾天",
                "zh-Hans": "未来几天"
              },
              "help": {
                "en": "Today included, as many as fit. 0 hides them.",
                "es": "Hoy incluido, los que quepan. 0 los oculta.",
                "zh-Hant": "包含今天，能放幾天就放幾天。0 表示隱藏。",
                "zh-Hans": "包含今天，能放几天就放几天。0 表示隐藏。"
              }
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "showMoon": {
            "title": "Moon phase",
            "description": "Only on wide tiles.",
            "default": true,
            "x-ui": {
              "label": {
                "en": "Moon phase",
                "es": "Fase de la luna",
                "zh-Hant": "月相",
                "zh-Hans": "月相"
              },
              "help": {
                "en": "Only on wide tiles.",
                "es": "Sólo en teselas anchas.",
                "zh-Hant": "僅限寬方格。",
                "zh-Hans": "仅限宽格子。"
              }
            },
            "type": "boolean"
          },
          "showDetails": {
            "title": "Feels like, humidity and wind",
            "description": "Under the temperature, when there is room.",
            "default": false,
            "x-ui": {
              "label": {
                "en": "Feels like, humidity and wind",
                "es": "Sensación, humedad y viento",
                "zh-Hant": "體感溫度、濕度與風",
                "zh-Hans": "体感温度、湿度和风"
              },
              "help": {
                "en": "Under the temperature, when there is room.",
                "es": "Bajo la temperatura, si hay sitio.",
                "zh-Hant": "顯示在溫度下方，空間足夠時。",
                "zh-Hans": "显示在温度下方，空间足够时。"
              }
            },
            "type": "boolean"
          }
        }
      },
      "screenshot": "docs/forecast.png",
      "animated": false,
      "urgent": false
    }
  ],
  "sources": [
    {
      "type": "weather/current",
      "name": {
        "en": "Current weather",
        "es": "Tiempo actual",
        "zh-Hant": "目前天氣",
        "zh-Hans": "当前天气"
      },
      "description": {
        "en": "Now, the next 48 hours and the next 7 days, from Open-Meteo (no key needed), for your place in Settings or the one set here.",
        "es": "Ahora, las próximas 48 horas y los próximos 7 días, de Open-Meteo (sin clave), para tu lugar de los ajustes o el que pongas aquí.",
        "zh-Hant": "現在、未來 48 小時與未來 7 天的天氣，來自 Open-Meteo（不需金鑰），地點取自「設定」或在此指定。",
        "zh-Hans": "现在、未来 48 小时和未来 7 天的天气，来自 Open-Meteo（无需密钥），地点取自“设置”或在此指定。"
      },
      "polled": true,
      "intervalMs": 900000,
      "options": {
        "default": {
          "units": "metric",
          "latitude": 0,
          "longitude": 0,
          "placeName": ""
        },
        "x-ui": {},
        "type": "object",
        "properties": {
          "units": {
            "title": "Units",
            "default": "metric",
            "x-ui": {
              "label": {
                "en": "Units",
                "es": "Unidades",
                "zh-Hant": "單位",
                "zh-Hans": "单位"
              },
              "labels": {
                "metric": {
                  "en": "Metric (°C, km/h)",
                  "es": "Métricas (°C, km/h)",
                  "zh-Hant": "公制（°C、km/h）",
                  "zh-Hans": "公制（°C、km/h）"
                },
                "imperial": {
                  "en": "Imperial (°F, mph)",
                  "es": "Imperiales (°F, mph)",
                  "zh-Hant": "英制（°F、mph）",
                  "zh-Hans": "英制（°F、mph）"
                }
              }
            },
            "type": "string",
            "enum": [
              "metric",
              "imperial"
            ]
          },
          "latitude": {
            "title": "Latitude",
            "description": "Leave latitude and longitude at 0 to use the place in Settings.",
            "default": 0,
            "x-ui": {
              "label": {
                "en": "Latitude",
                "es": "Latitud",
                "zh-Hant": "緯度",
                "zh-Hans": "纬度"
              },
              "help": {
                "en": "Leave latitude and longitude at 0 to use the place in Settings.",
                "es": "Con latitud y longitud a 0 se usa el lugar de los ajustes.",
                "zh-Hant": "緯度和經度保持 0 即使用設定中的地點。",
                "zh-Hans": "纬度和经度保持为 0 时使用设置中的地点。"
              },
              "advanced": true,
              "unit": "°",
              "step": 0.0001
            },
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "title": "Longitude",
            "default": 0,
            "x-ui": {
              "label": {
                "en": "Longitude",
                "es": "Longitud",
                "zh-Hant": "經度",
                "zh-Hans": "经度"
              },
              "advanced": true,
              "unit": "°",
              "step": 0.0001
            },
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "placeName": {
            "title": "Place name",
            "description": "Empty: the one in Settings.",
            "default": "",
            "x-ui": {
              "label": {
                "en": "Place name",
                "es": "Nombre del lugar",
                "zh-Hant": "地點名稱",
                "zh-Hans": "地点名称"
              },
              "help": {
                "en": "Empty: the one in Settings.",
                "es": "Vacío: el de los ajustes.",
                "zh-Hant": "留空：使用設定中的地點。",
                "zh-Hans": "留空：使用设置中的地点。"
              },
              "advanced": true,
              "placeholder": "Madrid"
            },
            "type": "string"
          }
        }
      }
    }
  ],
  "interludes": [],
  "templates": []
}
